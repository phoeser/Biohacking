// STATUS: Am 23.08.2026 veroeffentlicht und aktiv.
// Diese Datei ist nur noch die Referenz-Kopie des ergaenzten Blocks.
// Die aktiven Regeln stehen in der Firebase-Konsole:
//   Firestore Database -> Reiter "Regeln"
//
// Der Block wurde in den bestehenden Regelsatz EINGEFUEGT, nicht ersetzt.
// Die vorhandenen Regeln fuer users, wearables, vitals, supplementLog,
// recommendations, healthkit, config und oauthStates sind unveraendert.
//
// Wenn hier etwas geaendert wird, muss es in der Konsole nachgezogen werden –
// diese Datei wird von Firebase nicht ausgelesen.

    // ===== Erfahrungsberichte =====

    function istErfahrungsAdmin() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && request.auth.token.email == 'phoeser@web.de';
    }

    match /erfahrungen/{id} {

      allow read: if resource.data.status == 'approved'
                  || istErfahrungsAdmin()
                  || (request.auth != null && request.auth.uid == resource.data.uid);

      allow create: if request.auth != null
                    && request.resource.data.status == 'pending'
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.substanz is string
                    && request.resource.data.substanz.size() > 0
                    && request.resource.data.substanz.size() <= 120
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 4000;

      allow update, delete: if istErfahrungsAdmin();
    }

    // ===== Ende Erfahrungsberichte =====
